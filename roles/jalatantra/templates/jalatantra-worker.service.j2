[Unit]
Description=JalaTantra restricted automation worker
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jalatantra
Environment=JALATANTRA_CONFIG=/etc/jalatantra/worker.json
Environment=JALATANTRA_DB_USER=jalatantra_worker
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/jalatantra/worker.py
RuntimeDirectory=jalatantra-worker
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=3
TimeoutStopSec=150
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/jalatantra-worker
UMask=0077

[Install]
WantedBy=multi-user.target
