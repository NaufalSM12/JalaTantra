$TTL 3600
@   IN  SOA ns1.{{ project_domain }}. hostmaster.{{ project_domain }}. (
        {{ bind9_zone_serial }} ; serial
        3600                    ; refresh
        900                     ; retry
        1209600                 ; expire
        300                     ; negative cache
)
    IN  NS  ns1.{{ project_domain }}.
{% for record in bind9_zone_records %}
{{ record.name }}    IN  A   {{ record.address }}
{% endfor %}
